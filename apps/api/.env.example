# VYSEL API — local configuration template.
# Copy to apps/api/.env and fill in real values. Never commit .env.

# PostgreSQL 15 — database "vysel", owned by role "vysel"
DATABASE_URL=postgresql+psycopg://vysel:CHANGE_ME@localhost:5432/vysel

# Use 127.0.0.1, not "localhost": on Windows, localhost tries IPv6 (::1) first and
# Memurai listens on IPv4 only, costing ~2 s per connection.
# Redis (Memurai on Windows, redis-server on Linux/macOS) — db 0 for app cache,
# db 1 as the Celery broker, db 2 for Celery results.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
