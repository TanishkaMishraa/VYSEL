# VYSEL API — local configuration template.
# Copy to apps/api/.env and fill in real values. Never commit .env.

# PostgreSQL 15 — database "vysel", owned by role "vysel"
DATABASE_URL=postgresql+psycopg://vysel:CHANGE_ME@localhost:5432/vysel

# Use 127.0.0.1, not "localhost": on Windows, localhost tries IPv6 (::1) first and
# Memurai listens on IPv4 only, costing ~2 s per connection.
# Redis (Memurai on Windows, redis-server on Linux/macOS) — db 0 for app cache,
# db 1 as the Celery broker, db 2 for Celery results.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Selfie upload validation and private storage (keep outside apps/web/public).
SELFIE_STORAGE_DIR=.private/selfies
SELFIE_MAX_FILE_SIZE_BYTES=5242880
SELFIE_MIN_WIDTH=256
SELFIE_MIN_HEIGHT=256
SELFIE_MAX_WIDTH=8192
SELFIE_MAX_HEIGHT=8192
SELFIE_MAX_PIXELS=40000000
SELFIE_MIN_BLUR_VARIANCE=35
SELFIE_MIN_BRIGHTNESS=35
SELFIE_MAX_BRIGHTNESS=225
SELFIE_MAX_DARK_PIXEL_RATIO=0.75
SELFIE_MAX_BRIGHT_PIXEL_RATIO=0.75

# Face detection and landmarks (MediaPipe). The model is downloaded and SHA-256 verified by
# `python scripts/setup_face_analysis.py` (the start scripts run it). Defaults are MediaPipe's
# documented defaults; see FACE_ANALYSIS.md before changing any threshold.
FACE_MODEL_PATH=models/face_landmarker.task
FACE_MIN_DETECTION_CONFIDENCE=0.5
FACE_MIN_PRESENCE_CONFIDENCE=0.5
FACE_LOW_CONFIDENCE_WARNING=0.7
FACE_MIN_FACE_WIDTH_PX=128
FACE_ROTATION_SEARCH=true

# Skin colour and undertone (Phase 4.3). Method constants, not tuned on photos; change them only
# after a sweep on the validation split (see SKIN_ANALYSIS.md and scripts/evaluate_skin.py).
SKIN_WHITE_BALANCE=shades_of_gray
SKIN_WB_MAX_GAIN=1.5
SKIN_UNDERTONE_REFERENCE_HUE=55
SKIN_UNDERTONE_NEUTRAL_DELTA_H=2.5
# Optional lightness-dependent reference fitted on validation data (evaluate_skin.py --fit-reference):
# SKIN_UNDERTONE_REFERENCE_PATH=models/undertone_reference.json

# Face shape and facial attributes (Phase 4.4). Untuned starting values; see FACIAL_ATTRIBUTES.md.
# Optional face-shape prototypes fitted on validation data (evaluate_attributes.py --fit-prototypes):
# FACE_SHAPE_PROTOTYPES_PATH=models/face_shape.json
HAIR_SKIN_DELTA_E=8
HAIR_BACKGROUND_DELTA_E=8
CONTRAST_LOW_MAX_DELTA_L=20
CONTRAST_MEDIUM_MAX_DELTA_L=40
